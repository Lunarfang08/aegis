{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustStore",
  "type": "object",
  "properties": {
    "keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrustedKey"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "keys"
  ],
  "$defs": {
    "TrustedKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "public_key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "public_key",
        "label"
      ]
    }
  }
}
